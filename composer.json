{
    "name": "hoceineel/filament-undo-toast",
    "description": "Gmail-style undo toasts for Filament delete, restore, edit and detach actions, with a countdown and mod+z.",
    "keywords": [
        "hoceineel",
        "laravel",
        "filament",
        "undo",
        "toast",
        "notifications",
        "soft-deletes"
    ],
    "homepage": "https://github.com/HoceineEl/filament-undo-toast",
    "license": "MIT",
    "authors": [
        {
            "name": "Hoceine El Idrissi",
            "email": "contact@hoceine.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HoceineEl\\UndoToast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HoceineEl\\UndoToast\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HoceineEl\\UndoToast\\UndoToastServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
